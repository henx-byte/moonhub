#!/usr/bin/env bash
# moon-gitingest v1.4.0 - Android wuz wuz edition
# Support both single file and directory

set -e

VERSION="1.4.0"
TARGET_PATH="."
OUTPUT_FILE=""
SHOW_TREE_ONLY=false
IS_SINGLE_FILE=false

IGNORE_DIRS=(
  "node_modules"
  ".git"
  ".next"
  "dist"
  "build"
  ".expo"
  "android/app/build"
  "ios/build"
  ".gradle"
  "__pycache__"
  ".venv"
  "vendor"
  "moon-gitingest"
)

IGNORE_EXT=(
  "*.png" "*.jpg" "*.jpeg" "*.gif" "*.webp" "*.ico" "*.svg"
  "*.mp4" "*.mp3" "*.wav" "*.ttf" "*.otf" "*.woff" "*.woff2"
  "*.zip" "*.tar" "*.gz" "*.apk" "*.aab" "*.txt"
  "*.lock" "package-lock.json" "yarn.lock" "pnpm-lock.yaml"
)

print_help() {
cat <<'HELP'
moon-gitingest - Pack codebase for gitingest

Usage:
  ./moon-gitingest [options]

Options:
  -d, --dir <path>       Directory OR single file to scan (default: .)
                         ./moon-gitingest -d .
                         ./moon-gitingest -d ./app
                         ./moon-gitingest -d ./src/index.ts  # single file!
  -f, --file <path>      Alias for -d when scanning single file
  -o, --output <file>    Output file (default: ./gitingest-<name>.txt)
  -v, --version          Show version
  -h, --help             Show this help
  --tree                 Only show file tree, no content

Features:
  - Auto skip: node_modules, .git, dist, build, etc
  - Auto skip binary/images/*.txt
  - Support single file scan
  - Output ready for gitingest.com

Examples:
  ./moon-gitingest -d .                          # whole dir
  ./moon-gitingest -d ./app -o out.txt           # dir to file
  ./moon-gitingest -f ./src/App.tsx              # single file
  ./moon-gitingest -d ./src/utils.ts             # single file via -d
  ./moon-gitingest -d . --tree                    # only tree
HELP
}

print_version() { echo "moon-gitingest v$VERSION"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--dir) TARGET_PATH="$2"; shift 2 ;;
    -f|--file) TARGET_PATH="$2"; shift 2 ;;
    -o|--output) OUTPUT_FILE="$2"; shift 2 ;;
    -v|--version) print_version; exit 0 ;;
    -h|--help) print_help; exit 0 ;;
    --tree) SHOW_TREE_ONLY=true; shift ;;
    *) echo "Unknown option: $1"; print_help; exit 1 ;;
  esac
done

if [ ! -e "$TARGET_PATH" ]; then
  echo "[ERROR] Path not found: $TARGET_PATH"
  exit 1
fi

TMP_LIST=$(mktemp)

if [ -f "$TARGET_PATH" ]; then
  IS_SINGLE_FILE=true
  TARGET_PATH=$(cd "$(dirname "$TARGET_PATH")" && pwd)/$(basename "$TARGET_PATH")
  BASENAME=$(basename "$TARGET_PATH")
  TARGET_DIR=$(dirname "$TARGET_PATH")
  echo "$TARGET_PATH" > "$TMP_LIST"
  echo "[moonhub-gitingest v$VERSION] Single file mode: $TARGET_PATH"
  
  if [ -z "$OUTPUT_FILE" ]; then
    OUTPUT_FILE="./gitingest-${BASENAME}.txt"
  fi
else
  TARGET_DIR=$(cd "$TARGET_PATH" && pwd)
  BASENAME=$(basename "$TARGET_DIR")
  echo "[moonhub-gitingest v$VERSION] Scanning: $TARGET_DIR"
  echo "[ignore dirs] ${IGNORE_DIRS[*]}"
  echo "[ignore ext] ${IGNORE_EXT[*]}"

  if [ -z "$OUTPUT_FILE" ]; then
    OUTPUT_FILE="./gitingest-${BASENAME}.txt"
  fi

  OUTPUT_FILE_ABS=$(cd "$(dirname "$OUTPUT_FILE")" 2>/dev/null && pwd)/$(basename "$OUTPUT_FILE") 2>/dev/null || echo "$OUTPUT_FILE"
  OUTPUT_BASENAME=$(basename "$OUTPUT_FILE")

  FIND_ARGS=("$TARGET_DIR" -type f)
  for d in "${IGNORE_DIRS[@]}"; do
    FIND_ARGS+=(-not -path "*/$d/*" -not -path "*/$d")
  done
  for pat in "${IGNORE_EXT[@]}"; do
    FIND_ARGS+=(-not -name "$pat")
  done
  FIND_ARGS+=(-not -name "$OUTPUT_BASENAME" -not -path "$OUTPUT_FILE_ABS" -not -name "gitingest-*.txt")

  find "${FIND_ARGS[@]}" | sort > "$TMP_LIST"
fi

COUNT=$(wc -l < "$TMP_LIST")
echo "[found] $COUNT files"

if [ "$SHOW_TREE_ONLY" = true ]; then
  cat "$TMP_LIST"
  rm "$TMP_LIST"
  exit 0
fi

{
echo "# Gitingest Dump - Moonhub"
echo "# Source: $TARGET_PATH"
echo "# Version: $VERSION"
echo "# Generated: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
echo "# Mode: $([ "$IS_SINGLE_FILE" = true ] && echo "single-file" || echo "directory")"
echo "# Files: $COUNT"
echo ""
echo "## File Tree"
if [ "$IS_SINGLE_FILE" = true ]; then
  echo "$BASENAME"
else
  cat "$TMP_LIST" | sed "s|$TARGET_DIR|.|g"
fi
echo ""
echo "---"
echo ""

while IFS= read -r file; do
  [ -z "$file" ] && continue
  if [ "$IS_SINGLE_FILE" = true ]; then
    rel="$BASENAME"
  else
    rel=${file#$TARGET_DIR/}
  fi
  size=$(wc -c < "$file" 2>/dev/null || echo 0)
  if [ "$size" -gt 512000 ]; then
    echo "## FILE: $rel (SKIPPED - ${size} bytes too large)"
    echo ""
    continue
  fi
  echo "## FILE: $rel"
  echo '```'
  # For single file mode, always show even if binary-ish
  if [ "$IS_SINGLE_FILE" = true ]; then
    cat "$file"
  else
    if file "$file" | grep -qi "text"; then
      cat "$file"
    else
      echo "[binary file skipped]"
    fi
  fi
  echo '```'
  echo ""
done < "$TMP_LIST"

} > "$OUTPUT_FILE"

rm "$TMP_LIST"
echo "[OK] Output -> $OUTPUT_FILE ($(wc -l < "$OUTPUT_FILE") lines, $(du -h "$OUTPUT_FILE" | cut -f1))"
