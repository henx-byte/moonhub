{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/features/*": ["src/features/*"],
      "@/sources/*": ["src/sources/*"],
      "@/locales/*": ["src/locales/*"],
      "@/hooks/*": ["src/hooks/*"]
    }
  }
}