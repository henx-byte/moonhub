// src/player/useHls.ts - useEffect cek title & artist -> replaceAsync
import { useRef, useState, useCallback, useEffect } from "react";
import { useVideoPlayer, VideoPlayer } from "expo-video";

function parseIcy(raw: string, fallback: string) {
  const c = raw.trim();
  if (c.includes(" - ")) {
    const [a, ...rest] = c.split(" - ");
    return { artist: a.trim(), title: rest.join(" - ").trim() };
  }
  return { artist: fallback, title: c };
}

export function useHls() {
  const playerRef = useRef<VideoPlayer | null>(null);
  const [current, setCurrent] = useState<any | null>(null);
  const [isPlaying, setIsPlaying] = useState(false);
  const [isBuffering, setIsBuffering] = useState(false);
  const [nowPlaying, setNowPlaying] = useState<string | null>(null);
  const [parsed, setParsed] = useState<{ title: string; artist: string } | null>(null);

  const player = useVideoPlayer("", (p: any) => {
    p.loop = false;
    p.muted = false;
    p.showNowPlayingNotification = true;
  });

  useEffect(() => {
    playerRef.current = player;
    const s1 = player.addListener("statusChange", (payload: any) => {
      const st = payload?.status || payload;
      if (st === "loading") setIsBuffering(true);
      if (st === "readyToPlay") setIsBuffering(false);
    });
    const s2 = player.addListener("playingChange", (v: boolean) => setIsPlaying(v));
    return () => { s1?.remove(); s2?.remove(); };
  }, [player]);

  // polling status-json.xsl
  useEffect(() => {
    const uri = current?.uri;
    if (!uri || !uri.includes("mari.co.id")) return;
    const poll = async () => {
      try {
        const base = uri.split("/").slice(0, 3).join("/");
        const res = await fetch(`${base}/status-json.xsl`, { headers: { "Cache-Control": "no-cache" } });
        const json = await res.json();
        const src = Array.isArray(json?.icestats?.source) ? json.icestats.source[0] : json?.icestats?.source;
        if (src?.title) setNowPlaying(src.title);
      } catch {}
    };
    poll();
    const id = setInterval(poll, 5000);
    return () => clearInterval(id);
  }, [current?.uri]);

  // ubah nowPlaying jadi title & artist
  useEffect(() => {
    if (!nowPlaying) return;
    const { artist, title } = parseIcy(nowPlaying, current?.title || "Gen FM");
    setParsed({ title, artist });
  }, [nowPlaying, current?.title]);

  // === INI YANG LU MAU: useEffect cek title & artist, kalau berubah replaceAsync ===
  useEffect(() => {
    if (!parsed || !current?.uri || !playerRef.current) return;
    
    const p: any = playerRef.current;
    console.log(p)
    const oldTitle = p.title || "Loading...";
    const oldArtist = p.artist || "Loading...";

    // cek apakah berubah
    if (parsed.title === oldTitle && parsed.artist === oldArtist) return;

    console.log("[ICY SPLIT] Berubah, replaceAsync:", { from: `${oldTitle} - ${oldArtist}`, to: `${parsed.title} - ${parsed.artist}` });

    ( () => {
      try {
        p.replaceAsync({
          uri: current.uri,
          metadata: {
            title: parsed.title,   // 【entity-Olivia Rodrigo¦canonical_name=Olivia Rodrigo】 / MAISHA KANNA
            artist: parsed.artist, // less / JUNGKIR BALIK
            artwork: current.thumbnail,
          },
          headers: { "Icy-MetaData": "1" },
        });
        // p.play();
      } catch (e) {
        console.log("[replaceAsync error]", e);
      }
    })();
  }, [parsed, current?.uri, current?.thumbnail]);

  const play = useCallback(async (item: any) => {
    setCurrent(item);
    setIsBuffering(true);
    setNowPlaying(null);
    setParsed(null);

    let finalTitle = item.title;
    let finalArtist = "";

    // fetch dulu sebelum play pertama
      try {
        const base = item.uri.split("/").slice(0, 3).join("/");
        const res = await fetch(`${base}/status-json.xsl`, { headers: { "Cache-Control": "no-cache" } });
        const json = await res.json();
        const src = Array.isArray(json?.icestats?.source) ? json.icestats.source[0] : json?.icestats?.source;
        const raw = src?.title;
        if (raw) {
          console.log("[Hls] Dapat metadata sebelum play:", raw);
          const { artist, title } = parseIcy(raw, item.title);
          finalTitle = title;
          finalArtist = artist;
          setNowPlaying(raw);
          setParsed({ title, artist });
        }
      } catch {}
    

    const source = {
      uri: item.uri,
      metadata: { title: finalTitle, artist: finalArtist, artwork: item.thumbnail },
      headers: { "Icy-MetaData": "1" },
    };
    console.log("[Hls] Loading with metadata:", finalTitle, "-", finalArtist);
    await (playerRef.current as any).replaceAsync?.(source);
    playerRef.current?.play();
  }, []);

  const pause = useCallback(async () => { try { playerRef.current?.pause(); } catch {} }, []);
  const resume = useCallback(async () => { try { playerRef.current?.play(); } catch {} }, []);
  const stop = useCallback(async () => { try { playerRef.current?.pause(); setCurrent(null); setNowPlaying(null); setParsed(null); } catch {} }, []);

  return { current, isPlaying, isBuffering, nowPlaying, play, pause, resume, stop, player };
}